---
import { getLiveEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const { slug } = Astro.params;

const { entry, error } = slug ? await getLiveEntry('posts', slug) : { entry: undefined, error: undefined };

if (error || !entry || entry.data.draft) {
  return new Response('Not Found', { status: 404 });
}

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="post-header">
      <h1>{entry.data.title}</h1>
      <p class="post-meta">
        <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
        {entry.data.description && (
          <>
            <span class="sep">/</span>
            <span>{entry.data.description}</span>
          </>
        )}
      </p>
    </header>
    <div class="prose" set:html={entry.rendered?.html ?? ''} />
  </article>
</Base>
