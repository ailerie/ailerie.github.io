---
interface EntryData {
  title: string;
  date: Date;
  description?: string;
  author?: string;
  quotes?: string[];
}

interface Entry {
  id: string;
  data: EntryData;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

{
  entries.length > 0 && (
    <ul class="entry-list">
      {entries.map((post) => {
        const isNote = Boolean(post.data.author);
        const quotes = isNote ? (post.data.quotes ?? []) : [];
        const description = isNote ? undefined : post.data.description;

        return (
          <li class="entry">
            <h2 class="entry-title">
              <a href={`/${post.id}/`}>{post.data.title}</a>
              <span class="entry-date">({fmt(post.data.date)})</span>
            </h2>
            {post.data.author && (
              <p class="entry-author">
                <span>{post.data.author}:</span>
              </p>
            )}
            {quotes.map((html) => (
              <blockquote set:html={html} />
            ))}
            {description && <p class="entry-desc">{description}</p>}
            <p class="entry-more">
              <a href={`/${post.id}/`}>[...] More</a>
            </p>
          </li>
        );
      })}
    </ul>
  )
}
